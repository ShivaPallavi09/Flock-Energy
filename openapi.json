{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy \u2014 Urja Meter Ops Modern REST API",
    "description": "High-performance, clean REST API wrapper over the legacy Urja Meter Ops web portal. Automates SvelteKit session authentication, normalizes inconsistent legacy and v2 meter schemas, provides rich consumption analytics, fast spatial filtering, and full network hierarchy reconstruction.",
    "version": "1.0.0"
  },
  "paths": {
    "/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Modern Web Client Dashboard",
        "description": "Interactive web application providing smart meter exploration,\nreal-time interval consumption charts, and electrical hierarchy visualization.",
        "operationId": "get_dashboard_dashboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service and Upstream Health Check",
        "description": "Check operational health of the wrapper service and connectivity to the Urja portal.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Trigger Portal Authentication / Re-auth",
        "description": "Explicitly trigger or refresh session authentication against the Urja portal.\n(Note: Authentication and re-authentication are also handled transparently by the client).",
        "operationId": "authenticate_portal_api_v1_auth_login_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/cache/refresh": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Force Refresh Fleet Cache",
        "description": "Force a re-sync of the smart meter and transformer fleet from the upstream portal.",
        "operationId": "refresh_cache_api_v1_cache_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and Filter Smart Meters",
        "description": "Retrieve a paginated list of smart meters.\nSupports multi-attribute relational filtering, text search across IDs,\nand spatial proximity search using the Haversine distance engine.",
        "operationId": "list_meters_api_v1_meters_get",
